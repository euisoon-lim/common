                            font-weight: 600;
                            cursor: pointer;
                        ">새로고침</button>
                    </div>
                `;
                return;
            }
            
            // 사용자 이름 표시
            const userNameDisplay = document.getElementById('user-name-display');
            if (userNameDisplay && currentUser.name) {
                userNameDisplay.textContent = currentUser.name;
                console.log('✅ 사용자명 UI 업데이트:', currentUser.name);
                console.log('📍 DOM 요소:', userNameDisplay);
            } else {
                console.error('❌ user-name-display 요소를 찾을 수 없거나 이름이 없음');
            }
            
            await loadScriptData();
            console.log('📚 스크립트 데이터:', scriptData.length, '개');
            
            await loadUserData();
            console.log('👤 사용자 데이터 로드 완료');
            
            renderCategorySelect();
            console.log('📂 카테고리 선택 렌더링 완료');
            
            renderCards();
            console.log('🎴 카드 렌더링 완료');
            
            updateCounts();
            console.log('📊 카운트 업데이트 완료');
            
            setupEventListeners();
            console.log('🎧 이벤트 리스너 설정 완료');
            
            console.log('✅ 앱 초기화 완료');
        }

        async function loadScriptData() {
            try {
                const cached = localStorage.getItem(CACHE_KEY);
                const cacheTime = localStorage.getItem(CACHE_KEY + '_time');
                
                if (cached && cacheTime && (Date.now() - parseInt(cacheTime)) < CACHE_DURATION) {
                    scriptData = JSON.parse(cached);
                    console.log('✅ 캐시 데이터 사용:', scriptData.length, '개');
                    console.log('📋 데이터 샘플:', scriptData[0]);
                    document.getElementById('loading').style.display = 'none';
                    return;
                }
                
                console.log('🌐 서버에서 데이터 로드 중...');
                const response = await fetch(GOOGLE_APPS_SCRIPT_URL);
                const result = await response.json();
                if (result.success) {
                    scriptData = result.data;
                    localStorage.setItem(CACHE_KEY, JSON.stringify(scriptData));
                    localStorage.setItem(CACHE_KEY + '_time', Date.now().toString());
                    console.log('✅ 데이터 로드 완료:', scriptData.length, '개');
                    console.log('📋 데이터 샘플:', scriptData[0]);
                    document.getElementById('loading').style.display = 'none';
                } else {
                    console.error('❌ 서버 응답 실패:', result);
                }
            } catch (error) {
                console.error('❌ 데이터 로드 실패:', error);
                document.getElementById('loading').innerHTML = '<div style="color: #ef4444;">데이터 로드 실패</div>';
            }
        }

        async function loadUserData() {
            if (!currentUser || !currentUser.email) return;
            
            try {
                const { data: favData } = await supabase
                    .from('user_favorites')
                    .select('script_id')
                    .eq('user_email', currentUser.email);
                favorites = favData ? favData.map(f => f.script_id) : [];

                const { data: memoData } = await supabase
                    .from('user_memos')
                    .select('*')
                    .eq('user_email', currentUser.email);
                memos = {};
                if (memoData) {
                    memoData.forEach(m => {
                        memos[m.script_id] = m.memo_text;
                    });
                }

                const { data: recentData } = await supabase
                    .from('user_recent')
                    .select('script_id')
                    .eq('user_email', currentUser.email)
                    .order('viewed_at', { ascending: false })
                    .limit(10);
                recentViewed = recentData ? recentData.map(r => r.script_id) : [];
                
                console.log('✅ 사용자 데이터:', {
                    favorites: favorites.length,
                    memos: Object.keys(memos).length,
                    recent: recentViewed.length
                });
            } catch (error) {
                console.error('사용자 데이터 로드 실패:', error);
            }
        }

        function renderCategorySelect() {
            const categories = ['전체', ...new Set(scriptData.map(s => s.category))];
            const select = document.getElementById('category-select');
            select.innerHTML = categories.map(cat => 
                `<option value="${cat}" ${cat === selectedCategory ? 'selected' : ''}>${cat}</option>`
            ).join('');
        }

        function renderCards() {
            const filtered = getFilteredData();
            const container = document.getElementById('cards-container');
            const noResults = document.getElementById('no-results');
            
            console.log('🔍 렌더링:', {
                전체데이터: scriptData.length,
                필터링결과: filtered.length,
                활성탭: activeTab,
                검색어: searchTerm,
                카테고리: selectedCategory
            });

            if (filtered.length === 0) {
                container.style.display = 'none';
                noResults.style.display = 'block';
                document.getElementById('results-count').textContent = '0개 화법';
                return;
            }

            container.style.display = 'block';
            noResults.style.display = 'none';
            document.getElementById('results-count').textContent = `${filtered.length}개 화법`;

            container.innerHTML = filtered.map(script => {
                const isFavorite = favorites.includes(script.id);
                const memo = memos[script.id];
                
                return `
                    <div class="card" data-id="${script.id}">
                        <div class="card-header" onclick="toggleCard(${script.id})">
                            <div class="card-header-left">
                                <div class="card-badges">
                                    <span class="badge badge-scene">${script.scene}</span>
                                    <span class="badge badge-category">${script.category}</span>
                                </div>
                                <div class="card-question">${script.question}</div>
                            </div>
                            <div style="display: flex; align-items: center;">
                                <button class="heart-btn" onclick="event.stopPropagation(); toggleFavorite(${script.id})">
                                    ${isFavorite ? 
                                        '<svg viewBox="0 0 24 24" fill="#ef4444" stroke="#ef4444" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"></path></svg>' : 
                                        '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"></path></svg>'
                                    }
                                </button>
                                <div class="expand-icon">
                                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                        <polyline points="6 9 12 15 18 9"></polyline>
                                    </svg>
                                </div>
                            </div>
                        </div>
                        <div class="card-body">
                            <div class="card-answer">${script.answer}</div>
                            ${memo ? `<div class="memo-box">
                                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                    <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"></path>
                                </svg>
                                <span>${memo}</span>
                            </div>` : ''}
                            <div class="keywords">
                                ${script.keywords.map(k => `<span class="keyword-tag">#${k}</span>`).join('')}
                            </div>
                            <div class="card-actions">
                                <button class="btn btn-primary" onclick="event.stopPropagation(); copyToClipboard('${script.answer.replace(/"/g, '&quot;').replace(/'/g, "\\'")}', this)">
                                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                        <rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect>
                                        <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path>
                                    </svg>
                                    복사
                                </button>
                                <button class="btn btn-secondary" onclick="event.stopPropagation(); openMemoModal(${script.id})">
                                    <svg width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                        <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"></path>
                                    </svg>
                                </button>
                                <button class="btn btn-tertiary" onclick="event.stopPropagation(); shareScript(${script.id})">
                                    <svg width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                        <line x1="22" y1="2" x2="11" y2="13"></line>
                                        <polygon points="22 2 15 22 11 13 2 9 22 2"></polygon>
                                    </svg>
                                </button>
                            </div>
                        </div>
                    </div>
                `;
            }).join('');
        }

        function toggleCard(id) {
            const card = document.querySelector(`.card[data-id="${id}"]`);
            card.classList.toggle('expanded');
            if (card.classList.contains('expanded')) {
                addToRecent(id);
            }
        }

        function getFilteredData() {
            let filtered = [...scriptData];

            // 탭별 필터링
            if (activeTab === 'all') {
                // 전체 탭 - 모든 데이터 사용
                // 카테고리 필터만 적용
                if (selectedCategory !== '전체') {
                    filtered = filtered.filter(s => s.category === selectedCategory);
                }
            } else if (activeTab === 'favorites') {
                filtered = filtered.filter(s => favorites.includes(s.id));
                // 카테고리 필터 적용
                if (selectedCategory !== '전체') {
                    filtered = filtered.filter(s => s.category === selectedCategory);
                }
            } else if (activeTab === 'recent') {
                filtered = filtered.filter(s => recentViewed.includes(s.id));
                filtered.sort((a, b) => recentViewed.indexOf(a.id) - recentViewed.indexOf(b.id));
                // 카테고리 필터 적용
                if (selectedCategory !== '전체') {
                    filtered = filtered.filter(s => s.category === selectedCategory);
                }
            } else if (activeTab === 'memos') {
                filtered = filtered.filter(s => memos[s.id]);
                // 카테고리 필터 적용
                if (selectedCategory !== '전체') {
                    filtered = filtered.filter(s => s.category === selectedCategory);
                }
            }

            // 검색 (모든 탭에 적용)
            if (searchTerm && searchTerm.trim()) {
                const term = searchTerm.trim().toLowerCase();
                filtered = filtered.filter(s => {
                    try {
                        const questionMatch = s.question && String(s.question).toLowerCase().includes(term);
                        const answerMatch = s.answer && String(s.answer).toLowerCase().includes(term);
                        const keywordMatch = s.keywords && Array.isArray(s.keywords) && 
                            s.keywords.some(k => k && String(k).toLowerCase().includes(term));
                        return questionMatch || answerMatch || keywordMatch;
                    } catch (e) {
                        console.error('검색 필터 에러:', e, s);
                        return false;
                    }
                });
            }

            console.log('활성 탭:', activeTab, '/ 검색어:', searchTerm, '/ 결과:', filtered.length);
            return filtered;
        }

        function updateCounts() {
            const favCount = favorites.length;
            const memoCount = Object.keys(memos).length;
            const recentCount = recentViewed.length;
            
            console.log('📊 카운트 업데이트:', {
                즐겨찾기: favCount,
                메모: memoCount,
                최근: recentCount
            });
            
            document.getElementById('fav-count').textContent = favCount;
            document.getElementById('memo-count').textContent = memoCount;
            document.getElementById('recent-count').textContent = recentCount;
            document.getElementById('floating-count').textContent = favCount;
            
            const floatingBadge = document.getElementById('floating-badge');
            if (favCount > 0) {
                floatingBadge.classList.add('active');
            } else {
                floatingBadge.classList.remove('active');
            }
        }

        function setupEventListeners() {
            // 탭 버튼
            document.querySelectorAll('.tab-btn').forEach(btn => {
                btn.addEventListener('click', () => {
                    document.querySelectorAll('.tab-btn').forEach(b => b.classList.remove('active'));
                    btn.classList.add('active');
                    activeTab = btn.dataset.tab;
                    renderCards();
                });
            });

            // 검색
            const searchInput = document.getElementById('search-input');
            const clearBtn = document.getElementById('clear-search');
            
            searchInput.addEventListener('input', (e) => {
                searchTerm = e.target.value;
                clearBtn.style.display = searchTerm ? 'block' : 'none';
                console.log('🔍 검색 입력:', searchTerm, '길이:', searchTerm.length);
                renderCards();
            });

            clearBtn.addEventListener('click', () => {
                searchTerm = '';
                searchInput.value = '';
                clearBtn.style.display = 'none';
                console.log('🔍 검색 초기화');
                renderCards();
            });

            // 카테고리
            document.getElementById('category-select').addEventListener('change', (e) => {
                selectedCategory = e.target.value;
                renderCards();
            });

            // 메모 모달
            document.getElementById('save-memo').addEventListener('click', saveMemo);
            document.getElementById('cancel-memo').addEventListener('click', closeMemoModal);
            document.getElementById('memo-modal').addEventListener('click', (e) => {
                if (e.target.id === 'memo-modal') closeMemoModal();
            });
        }

        async function toggleFavorite(id) {
            if (!currentUser || !currentUser.email) {
                alert('로그인이 필요합니다.');
                return;
            }
            
            try {
                if (favorites.includes(id)) {
                    await supabase
                        .from('user_favorites')
                        .delete()
                        .eq('user_email', currentUser.email)
                        .eq('script_id', id);
                    favorites = favorites.filter(f => f !== id);
                } else {
                    await supabase
                        .from('user_favorites')
                        .insert({ user_email: currentUser.email, script_id: id });
                    favorites.push(id);
                }
                updateCounts();
                renderCards();
            } catch (error) {
                console.error('즐겨찾기 오류:', error);
            }
        }

        async function addToRecent(id) {
            if (!currentUser || !currentUser.email) return;
            
            try {
                await supabase
                    .from('user_recent')
                    .insert({ user_email: currentUser.email, script_id: id });
                
                recentViewed = recentViewed.filter(r => r !== id);
                recentViewed.unshift(id);
                recentViewed = recentViewed.slice(0, 10);
                updateCounts();
            } catch (error) {
                console.error('최근 항목 오류:', error);
            }
        }

        function copyToClipboard(text, btn) {
            const decoded = text.replace(/&quot;/g, '"').replace(/&#39;/g, "'");
            navigator.clipboard.writeText(decoded).then(() => {
                const originalText = btn.innerHTML;
                btn.innerHTML = '<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"></polyline></svg> 복사완료';
                setTimeout(() => {
                    btn.innerHTML = originalText;
                }, 2000);
            });
        }

        function shareScript(id) {
            const script = scriptData.find(s => s.id === id);
            const text = `${script.question}\n\n${script.answer}`;
            
            if (navigator.share) {
                navigator.share({ title: script.question, text: text });
            } else {
                copyToClipboard(text, { innerHTML: '' });
                alert('클립보드에 복사되었습니다!');
            }
        }

        function openMemoModal(id) {
            if (!currentUser || !currentUser.email) {
                alert('로그인이 필요합니다.');
                return;
            }
            currentMemoId = id;
            document.getElementById('memo-textarea').value = memos[id] || '';
            document.getElementById('memo-modal').classList.add('active');
        }

        function closeMemoModal() {
            document.getElementById('memo-modal').classList.remove('active');
            currentMemoId = null;
        }

        async function saveMemo() {
            if (!currentUser || !currentUser.email) return;
            
            const memo = document.getElementById('memo-textarea').value.trim();
            
            try {
                if (memo) {
                    await supabase
                        .from('user_memos')
                        .upsert({
                            user_email: currentUser.email,
                            script_id: currentMemoId,
                            memo_text: memo,
                            updated_at: new Date().toISOString()
                        }, {
                            onConflict: 'user_email,script_id'
                        });
                    memos[currentMemoId] = memo;
                } else {
                    await supabase
                        .from('user_memos')
                        .delete()
                        .eq('user_email', currentUser.email)
                        .eq('script_id', currentMemoId);
                    delete memos[currentMemoId];
                }
                closeMemoModal();
                updateCounts();
                renderCards();
            } catch (error) {
                console.error('메모 저장 오류:', error);
            }
        }

        init();
    </script>
</body>
