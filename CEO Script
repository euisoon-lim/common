<!DOCTYPE html>
<html lang="ko">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>상담 스크립트</title>
    <script src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2"></script>
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body.ceo-script-page {
            font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', 'Roboto', sans-serif;
            background: #0a0a0a;
            color: #ffffff;
            min-height: 100vh;
        }

        /* 아임웹 요소 스타일 보호 */
        body.ceo-script-page .modal-dialog,
        body.ceo-script-page .modal-content:not(.ceo-modal-content),
        body.ceo-script-page .modal-body,
        body.ceo-script-page .modal-header,
        body.ceo-script-page .modal-footer,
        body.ceo-script-page .form-control,
        body.ceo-script-page .btn:not(.ceo-script-container .btn),
        body.ceo-script-page [class*="imweb"],
        body.ceo-script-page [id*="imweb"],
        body.ceo-script-page input:not(.ceo-search-input),
        body.ceo-script-page select:not(.category-select),
        body.ceo-script-page textarea:not(.modal-textarea) {
            background: white !important;
            color: #333 !important;
            border-color: #ddd !important;
        }

        .ceo-script-container {
            max-width: 900px;
            margin: 0 auto;
            padding: 0;
        }

        .header {
            background: linear-gradient(135deg, #1a1a1a, #2a2a2a);
            padding: 24px;
            border-radius: 16px;
            border: 1px solid #333;
            margin-bottom: 20px;
            position: sticky;
            top: 20px;
            z-index: 100;
        }

        .header h1 {
            font-size: 24px;
            color: #ffffff;
            font-weight: 600;
            margin-bottom: 16px;
            text-align: left;
        }

        .header h1 .user-name {
            color: #8b5cf6;
            font-weight: 700;
        }

        .tabs {
            display: flex;
            gap: 8px;
            flex-wrap: wrap;
            justify-content: flex-start;
        }

        .tab-btn {
            padding: 10px 16px;
            border: 1px solid #333;
            border-radius: 8px;
            font-size: 14px;
            font-weight: 500;
            cursor: pointer;
            transition: all 0.2s;
            background: transparent;
            color: #888;
            display: flex;
            align-items: center;
            gap: 6px;
        }

        .tab-btn.active {
            background: linear-gradient(135deg, #8b5cf6, #7c3aed);
            color: white;
            border-color: transparent;
        }

        .ceo-search-box {
            position: relative;
            margin-bottom: 20px;
        }

        .ceo-search-input {
            width: 100%;
            padding: 18px 50px 18px 55px;
            border: 2px solid #333;
            border-radius: 16px;
            font-size: 18px;
            transition: all 0.3s;
            background: linear-gradient(135deg, #1a1a1a, #2a2a2a);
            color: white;
            font-weight: 500;
        }

        .ceo-search-input:focus {
            outline: none;
            border-color: #8b5cf6;
            box-shadow: 0 0 0 4px rgba(139, 92, 246, 0.15), 0 8px 24px rgba(139, 92, 246, 0.2);
            background: #1a1a1a;
        }

        .ceo-search-input::placeholder {
            color: #666;
            font-weight: 400;
        }

        .ceo-search-icon {
            position: absolute;
            left: 20px;
            top: 50%;
            transform: translateY(-50%);
            color: #8b5cf6;
        }
        
        .ceo-search-icon svg {
            width: 24px;
            height: 24px;
            display: block;
        }

        .ceo-clear-btn {
            position: absolute;
            right: 20px;
            top: 50%;
            transform: translateY(-50%);
            background: rgba(139, 92, 246, 0.1);
            border: none;
            color: #8b5cf6;
            cursor: pointer;
            font-size: 26px;
            padding: 6px 10px;
            border-radius: 8px;
            display: none;
            transition: all 0.2s;
        }

        .ceo-clear-btn:hover {
            background: rgba(139, 92, 246, 0.2);
        }

        .filter-section {
            background: linear-gradient(135deg, #1a1a1a, #2a2a2a);
            padding: 16px;
            border-radius: 12px;
            margin-bottom: 16px;
            border: 1px solid #333;
        }

        .filter-title {
            font-size: 17px;
            font-weight: 600;
            color: #ffffff;
            margin-bottom: 12px;
        }

        .category-select {
            width: 100%;
            padding: 12px 16px;
            background: #0a0a0a;
            border: 1px solid #333;
            border-radius: 8px;
            color: white;
            font-size: 17px;
            cursor: pointer;
            transition: all 0.2s;
        }

        .category-select:hover {
            border-color: #8b5cf6;
        }

        .category-select:focus {
            outline: none;
            border-color: #8b5cf6;
            box-shadow: 0 0 0 3px rgba(139, 92, 246, 0.1);
        }

        .results-count {
            font-size: 16px;
            color: #666;
            margin-bottom: 12px;
        }

        .loading {
            text-align: center;
            padding: 40px;
            color: #666;
            background: linear-gradient(135deg, #1a1a1a, #2a2a2a);
            border-radius: 16px;
            border: 1px solid #333;
            font-size: 17px;
        }

        .skeleton {
            background: linear-gradient(90deg, #1a1a1a 25%, #2a2a2a 50%, #1a1a1a 75%);
            background-size: 200% 100%;
            animation: loading 1.5s infinite;
            border-radius: 8px;
            height: 20px;
            margin-bottom: 12px;
        }

        @keyframes loading {
            0% { background-position: 200% 0; }
            100% { background-position: -200% 0; }
        }

        .card {
            background: linear-gradient(135deg, #1a1a1a, #2a2a2a);
            border-radius: 16px;
            border: 1px solid #333;
            margin-bottom: 16px;
            overflow: hidden;
            transition: all 0.2s;
            cursor: pointer;
        }

        .card:hover {
            border-color: #8b5cf6;
            box-shadow: 0 4px 12px rgba(139, 92, 246, 0.2);
        }

        .card-header {
            padding: 20px;
            display: flex;
            justify-content: space-between;
            align-items: start;
        }

        .card-header-left {
            flex: 1;
        }

        .card-badges {
            display: flex;
            gap: 8px;
            margin-bottom: 12px;
            align-items: center;
            flex-wrap: wrap;
        }

        .badge {
            display: inline-block;
            padding: 4px 10px;
            border-radius: 12px;
            font-size: 13px;
            font-weight: 600;
        }

        .badge-scene {
            background: rgba(139, 92, 246, 0.2);
            color: #a78bfa;
            border: 1px solid rgba(139, 92, 246, 0.3);
        }

        .badge-category {
            background: rgba(255, 255, 255, 0.05);
            color: #888;
            border: 1px solid #333;
        }

        .card-question {
            font-size: 19px;
            font-weight: 600;
            color: #ffffff;
            line-height: 1.5;
        }

        .expand-icon {
            color: #666;
            transition: all 0.3s;
            margin-left: 12px;
            display: flex;
            align-items: center;
        }
        
        .expand-icon svg {
            width: 20px;
            height: 20px;
        }

        .card.expanded .expand-icon {
            transform: rotate(180deg);
            color: #8b5cf6;
        }

        .card-body {
            max-height: 0;
            overflow: hidden;
            transition: max-height 0.3s ease-out;
            padding: 0 20px;
        }

        .card.expanded .card-body {
            max-height: 2000px;
            padding: 0 20px 20px 20px;
        }

        .card-answer {
            color: #ccc;
            font-size: 17px;
            line-height: 1.7;
            margin-bottom: 16px;
            padding-top: 20px;
        }

        .card.expanded .card-answer {
            border-top: 1px solid #333;
        }

        .memo-box {
            background: rgba(234, 179, 8, 0.1);
            border: 1px solid rgba(234, 179, 8, 0.3);
            border-radius: 8px;
            padding: 12px;
            margin-bottom: 12px;
            font-size: 16px;
            color: #fbbf24;
            display: flex;
            gap: 8px;
            align-items: start;
        }
        
        .memo-box svg {
            flex-shrink: 0;
            margin-top: 2px;
        }

        .keywords {
            display: flex;
            flex-wrap: wrap;
            gap: 6px;
            margin-bottom: 12px;
        }

        .keyword-tag {
            background: rgba(255, 255, 255, 0.05);
            color: #888;
            padding: 4px 10px;
            border-radius: 12px;
            font-size: 14px;
            border: 1px solid #333;
        }

        .card-actions {
            display: flex;
            gap: 8px;
            padding-top: 12px;
            border-top: 1px solid #333;
        }

        .btn {
            flex: 1;
            padding: 10px;
            border: 1px solid #333;
            border-radius: 10px;
            font-size: 16px;
            font-weight: 500;
            cursor: pointer;
            transition: all 0.2s;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 8px;
            background: transparent;
            color: #ccc;
        }
        
        .btn svg {
            flex-shrink: 0;
        }

        .btn-primary {
            background: linear-gradient(135deg, #8b5cf6, #7c3aed);
            color: white;
            border: none;
        }

        .btn-primary:hover {
            background: linear-gradient(135deg, #7c3aed, #6d28d9);
        }

        .btn-secondary {
            background: rgba(139, 92, 246, 0.1);
            color: #8b5cf6;
            border-color: rgba(139, 92, 246, 0.3);
            flex: 0;
            padding: 10px 12px;
            position: relative;
        }
        
        .btn-secondary:hover::after {
            content: '나만의 메모';
            position: absolute;
            bottom: 100%;
            left: 50%;
            transform: translateX(-50%);
            margin-bottom: 8px;
            padding: 6px 12px;
            background: #1a1a1a;
            color: white;
            border: 1px solid #333;
            border-radius: 6px;
            font-size: 13px;
            white-space: nowrap;
            z-index: 1000;
        }
        
        .btn-secondary svg {
            width: 19px;
            height: 19px;
        }

        .btn-tertiary {
            background: rgba(139, 92, 246, 0.1);
            color: #8b5cf6;
            border-color: rgba(139, 92, 246, 0.3);
            flex: 0;
            padding: 10px 12px;
            position: relative;
        }

        .btn-tertiary:hover::after {
            content: '공유하기';
            position: absolute;
            bottom: 100%;
            left: 50%;
            transform: translateX(-50%);
            margin-bottom: 8px;
            padding: 6px 12px;
            background: #1a1a1a;
            color: white;
            border: 1px solid #333;
            border-radius: 6px;
            font-size: 13px;
            white-space: nowrap;
            z-index: 1000;
        }
        
        .btn-tertiary svg {
            width: 19px;
            height: 19px;
        }

        .btn-tertiary:hover, .btn-secondary:hover {
            border-color: #8b5cf6;
            background: rgba(139, 92, 246, 0.2);
        }

        .heart-btn {
            background: none;
            border: none;
            cursor: pointer;
            padding: 4px;
            transition: all 0.2s;
            display: flex;
            align-items: center;
        }
        
        .heart-btn svg {
            width: 24px;
            height: 24px;
        }

        .heart-btn:hover {
            transform: scale(1.1);
        }

        .modal {
            display: none;
            position: fixed;
            top: 0;
            left: 0;
            right: 0;
            bottom: 0;
            background: rgba(0,0,0,0.8);
            z-index: 99999;
            padding: 20px;
            align-items: center;
            justify-content: center;
        }

        .modal.active {
            display: flex;
        }

        .modal-content {
            background: #1a1a1a;
            border: 1px solid #333;
            border-radius: 16px;
            padding: 24px;
            max-width: 500px;
            width: 100%;
            box-shadow: 0 20px 40px rgba(0,0,0,0.5);
            z-index: 100000;
            position: relative;
        }
        
        .ceo-modal-content {
            background: #1a1a1a;
            border: 1px solid #333;
            border-radius: 16px;
            padding: 24px;
            max-width: 500px;
            width: 100%;
            box-shadow: 0 20px 40px rgba(0,0,0,0.5);
            z-index: 100000;
            position: relative;
        }

        .modal-title {
            font-size: 22px;
            font-weight: 700;
            color: #ffffff;
            margin-bottom: 16px;
        }

        .modal-textarea {
            width: 100%;
            padding: 12px;
            border: 1px solid #333;
            border-radius: 8px;
            font-size: 17px;
            font-family: inherit;
            resize: vertical;
            min-height: 120px;
            background: #0a0a0a;
            color: white;
        }

        .modal-textarea:focus {
            outline: none;
            border-color: #8b5cf6;
        }

        .modal-actions {
            display: flex;
            gap: 8px;
            margin-top: 16px;
        }

        .no-results {
            text-align: center;
            padding: 60px 20px;
            background: linear-gradient(135deg, #1a1a1a, #2a2a2a);
            border-radius: 16px;
            border: 1px solid #333;
            font-size: 18px;
        }

        .floating-badge {
            position: fixed;
            bottom: 24px;
            right: 24px;
            background: linear-gradient(135deg, #ef4444, #dc2626);
            color: white;
            padding: 12px 20px;
            border-radius: 24px;
            font-weight: 600;
            font-size: 17px;
            box-shadow: 0 4px 12px rgba(239, 68, 68, 0.3);
            display: none;
            cursor: pointer;
            transition: all 0.2s;
            align-items: center;
            gap: 8px;
        }

        .floating-badge:hover {
            transform: translateY(-2px);
            box-shadow: 0 6px 16px rgba(239, 68, 68, 0.4);
        }

        .floating-badge.active {
            display: flex;
        }
        
        .floating-badge svg {
            flex-shrink: 0;
        }
    </style>
</head>
<body class="ceo-script-page">
    <div class="ceo-script-container">
        <div class="header">
            <h1><span class="user-name" id="user-name-display">사용자</span>님을 위한 상담 스크립트입니다.</h1>
            
            <div class="tabs">
                <button class="tab-btn active" data-tab="all">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"></path>
                    </svg>
                    전체
                </button>
                <button class="tab-btn" data-tab="favorites">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"></path>
                    </svg>
                    즐겨찾기 <span id="fav-count">0</span>
                </button>
                <button class="tab-btn" data-tab="memos">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
                        <polyline points="14 2 14 8 20 8"></polyline>
                        <line x1="16" y1="13" x2="8" y2="13"></line>
                        <line x1="16" y1="17" x2="8" y2="17"></line>
                        <polyline points="10 9 9 9 8 9"></polyline>
                    </svg>
                    메모 <span id="memo-count">0</span>
                </button>
                <button class="tab-btn" data-tab="recent">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <circle cx="12" cy="12" r="10"></circle>
                        <polyline points="12 6 12 12 16 14"></polyline>
                    </svg>
                    최근 <span id="recent-count">0</span>
                </button>
            </div>
        </div>

        <div class="ceo-search-box">
            <span class="ceo-search-icon">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <circle cx="11" cy="11" r="8"></circle>
                    <path d="m21 21-4.35-4.35"></path>
                </svg>
            </span>
            <input type="text" id="search-input" class="ceo-search-input" placeholder="질문이나 키워드로 검색...">
            <button class="ceo-clear-btn" id="clear-search">×</button>
        </div>

        <div class="filter-section">
            <div class="filter-title">카테고리</div>
            <select class="category-select" id="category-select">
                <option value="전체">전체 카테고리</option>
            </select>
        </div>

        <div class="results-count" id="results-count">데이터 로딩 중...</div>
        
        <div id="loading" class="loading">
            <div class="skeleton" style="width: 80%;"></div>
            <div class="skeleton" style="width: 60%;"></div>
            <div class="skeleton" style="width: 90%;"></div>
        </div>
        
        <div id="cards-container"></div>
        
        <div class="no-results" id="no-results" style="display:none;">
            <svg width="64" height="64" viewBox="0 0 24 24" fill="none" stroke="#333" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="margin: 0 auto 16px;">
                <circle cx="11" cy="11" r="8"></circle>
                <path d="m21 21-4.35-4.35"></path>
            </svg>
            <div style="color:#666;font-size:15px;">검색 결과가 없습니다</div>
        </div>
    </div>

    <div class="floating-badge" id="floating-badge" onclick="document.querySelector('[data-tab=favorites]').click()">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"></path>
        </svg>
        즐겨찾기 <span id="floating-count">0</span>개
    </div>

    <div class="modal" id="memo-modal">
        <div class="modal-content ceo-modal-content">
            <div class="modal-title">메모 작성</div>
            <textarea class="modal-textarea" id="memo-textarea" placeholder="이 화법에 대한 메모를 작성하세요..."></textarea>
            <div class="modal-actions">
                <button class="btn btn-primary" id="save-memo">저장</button>
                <button class="btn btn-tertiary" id="cancel-memo">취소</button>
            </div>
        </div>
    </div>

    <script>
        const GOOGLE_APPS_SCRIPT_URL = 'https://script.google.com/macros/s/AKfycbydvT2MM61I6bN2x1uJ-4_8AlnolmcrzvtMFvtKucNJkhLUPI64gobLe1OoWUNpRMb9YQ/exec';
        const SUPABASE_URL = 'https://pkxgjylcjophznokhlzb.supabase.co';
        const SUPABASE_ANON_KEY = 'eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6InBreGdqeWxjam9waHpub2tobHpiIiwicm9sZSI6ImFub24iLCJpYXQiOjE3NjEwMTI3MTUsImV4cCI6MjA3NjU4ODcxNX0.QkTqAyOmNG0Gy0nWf82TEj3o-YvbeqIa-REgCJSstk8';
        const CACHE_KEY = 'CEO_PLAN_SCRIPT_DATA';
        const CACHE_DURATION = 5 * 60 * 1000;

        const supabase = window.supabase.createClient(SUPABASE_URL, SUPABASE_ANON_KEY);

        let scriptData = [];
        let favorites = [];
        let recentViewed = [];
        let memos = {};
        let activeTab = 'all';
        let selectedCategory = '전체';
        let searchTerm = '';
        let currentMemoId = null;
        let currentUser = null;

        async function getUserInfo() {
            try {
                // 1. 세션 캐시 확인
                const sessionUser = sessionStorage.getItem('CEO_PLAN_USER');
                if (sessionUser && sessionUser !== 'null') {
                    try {
                        const userData = JSON.parse(sessionUser);
                        if (userData.email && userData.name && userData.name !== 'undefined' && 
                            userData.name !== '관리자' && userData.name !== 'admin' &&
                            userData.name !== 'Administrator' && userData.name !== '로그인' &&
                            userData.name !== '사용자' &&
                            !userData.email.includes('guest_') && !userData.email.includes('error@')) {
                            console.log('✅ 캐시된 회원 정보:', userData);
                            return userData;
                        } else {
                            console.log('⚠️ 캐시 무효화 (기본값):', userData.name);
                            sessionStorage.removeItem('CEO_PLAN_USER');
                        }
                    } catch (e) {
                        sessionStorage.removeItem('CEO_PLAN_USER');
                    }
                }
                
                // 2. 아임웹 전역 객체 확인 (가장 신뢰할 수 있는 방법)
                if (window.MEMBER && window.MEMBER.name && window.MEMBER.email) {
                    const userData = {
                        email: window.MEMBER.email,
                        name: window.MEMBER.name || window.MEMBER.nickname || window.MEMBER.email.split('@')[0],
                        uid: window.MEMBER.member_code || window.MEMBER.email.split('@')[0]
                    };
                    sessionStorage.setItem('CEO_PLAN_USER', JSON.stringify(userData));
                    console.log('✅ window.MEMBER에서 정보 가져옴:', userData);
                    return userData;
                }
                
                // 3. localStorage 확인
                const imwebMember = localStorage.getItem('IMWEB_MEMBER');
                if (imwebMember && imwebMember !== 'null' && imwebMember !== 'undefined') {
                    try {
                        const memberData = JSON.parse(imwebMember);
                        console.log('📦 localStorage IMWEB_MEMBER:', memberData);
                        
                        if (memberData.email && memberData.email.trim() && memberData.email.includes('@')) {
                            let userName = '사용자';
                            
                            if (memberData.name && memberData.name.trim() && 
                                memberData.name !== '로그인' && memberData.name !== 'Login' &&
                                memberData.name !== '관리자') {
                                userName = memberData.name.trim();
                            } else if (memberData.nickname && memberData.nickname.trim()) {
                                userName = memberData.nickname.trim();
                            } else {
                                userName = memberData.email.split('@')[0];
                            }
                            
                            const userData = {
                                email: memberData.email.trim(),
                                name: userName,
                                uid: memberData.uid || memberData.member_code || memberData.email.split('@')[0]
                            };
                            
                            sessionStorage.setItem('CEO_PLAN_USER', JSON.stringify(userData));
                            console.log('✅ localStorage에서 회원 정보:', userData);
                            return userData;
                        }
                    } catch (parseError) {
                        console.error('❌ localStorage 파싱 실패:', parseError);
                    }
                }
                
                // 4. 아임웹 API 호출 (/dialog/join.cm)
                console.log('🔍 아임웹 API 호출 시도...');
                try {
                    const response = await fetch("/dialog/join.cm", { 
                        credentials: "include",
                        cache: "no-cache"
                    });
                    const html = await response.text();
                    console.log('📄 HTML 응답 길이:', html.length);
                    
                    const parser = new DOMParser();
                    const doc = parser.parseFromString(html, "text/html");
                    
                    const nameInput = doc.querySelector('#join_name');
                    const emailInput = doc.querySelector('#join_email');
                    const uidInput = doc.querySelector('#join_user_id');
                    
                    console.log('🔍 폼 필드:', {
                        name: nameInput?.value,
                        email: emailInput?.value,
                        uid: uidInput?.value
                    });
                    
                    if (emailInput && emailInput.value && emailInput.value.includes('@')) {
                        let userName = '사용자';
                        
                        if (nameInput && nameInput.value && nameInput.value.trim()) {
                            const nameValue = nameInput.value.trim();
                            if (nameValue !== '로그인' && nameValue !== 'Login' && 
                                nameValue !== '관리자' && nameValue !== 'admin' &&
                                nameValue !== 'Administrator') {
                                userName = nameValue;
                                console.log('✅ join_name 사용:', userName);
                            }
                        }
                        
                        if (userName === '사용자' && uidInput && uidInput.value && uidInput.value.trim()) {
                            userName = uidInput.value.trim();
                            console.log('✅ join_user_id 사용:', userName);
                        }
                        
                        if (userName === '사용자') {
                            userName = emailInput.value.split('@')[0];
                            console.log('✅ 이메일 사용:', userName);
                        }
                        
                        const userData = {
                            email: emailInput.value.trim(),
                            name: userName,
                            uid: uidInput?.value?.trim() || emailInput.value.split('@')[0]
                        };
                        
                        sessionStorage.setItem('CEO_PLAN_USER', JSON.stringify(userData));
                        console.log('✅ API에서 회원 정보:', userData);
                        return userData;
                    }
                } catch (fetchError) {
                    console.warn('⚠️ API 호출 실패:', fetchError.message);
                }
                
                console.error('❌ 모든 방법 실패 - 사용자 정보를 찾을 수 없습니다');
                return null;
                
            } catch (error) {
                console.error('❌ getUserInfo 전체 오류:', error);
                return null;
            }
        }

        async function init() {
            console.log('🚀 앱 초기화 시작');
            currentUser = await getUserInfo();
            
            console.log('👤 현재 사용자:', currentUser);
            
            if (!currentUser || !currentUser.email) {
                console.log('❌ 로그인 필요');
                document.getElementById('loading').style.display = 'none';
                document.getElementById('cards-container').innerHTML = `
                    <div style="background: linear-gradient(135deg, #1a1a1a, #2a2a2a); padding: 60px 40px; border-radius: 16px; text-align: center; border: 1px solid #333;">
                        <svg width="64" height="64" viewBox="0 0 24 24" fill="none" stroke="#8b5cf6" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="margin: 0 auto 24px;">
                            <rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect>
                            <path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
                        </svg>
