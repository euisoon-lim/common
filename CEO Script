            const supabase = window.__supabaseClient || window.supabase.createClient(SUPABASE_URL, SUPABASE_ANON_KEY);
            if (!window.__supabaseClient) {
                window.__supabaseClient = supabase;
            }

            let scriptData = [];
            let favorites = [];
            let recentViewed = [];
            let memos = {};
            let activeTab = 'all';
            let selectedCategory = '전체';
            let searchTerm = '';
            let currentMemoId = null;
            let currentUser = null;
            
            // 무한 스크롤을 위한 페이지네이션 변수
            let currentPage = 1;
            let itemsPerPage = 5; // 초기 로딩 속도 개선을 위해 5개로 줄임
            let isLoading = false;

            async function getUserInfo() {
                try {
                    console.log('🔍 사용자 정보 가져오기 시작');
                    
                    // 1. 먼저 localStorage 확인 (가장 신뢰할 수 있음)
                    console.log('📦 localStorage 우선 확인...');
                    const imwebMember = localStorage.getItem('IMWEB_MEMBER');
                    
                    if (imwebMember && imwebMember !== 'null' && imwebMember !== 'false') {
                        try {
                            const memberData = JSON.parse(imwebMember);
                            console.log('📦 localStorage 데이터:', memberData);
                            
                            if (memberData.email && memberData.email.includes('@')) {
                                const userData = {
                                    email: memberData.email,
                                    name: memberData.name || memberData.nickname || memberData.email.split('@')[0],
                                    uid: memberData.uid || memberData.email.split('@')[0]
                                };
                                console.log('✅ localStorage로 사용자 정보 획득:', userData);
                                return userData;
                            }
                        } catch (e) {
                            console.error('❌ localStorage 파싱 오류:', e);
                        }
                    }
                    
                    // 2. localStorage 실패 시 fetch 시도
                    try {
                        console.log('📡 fetch 백업 시도...');
                        const response = await fetch("/dialog/join.cm", { credentials: "include" });
                        const html = await response.text();
                        
                        const parser = new DOMParser();
                        const doc = parser.parseFromString(html, "text/html");
                        
                        // 이름 찾기
                        const nameInput = doc.querySelector("#join_name") || 
                                         doc.querySelector('input[name="name"]');
                        
                        // 이메일 찾기 (여러 방법 시도)
                        const emailInput = doc.querySelector("#join_email") || 
                                          doc.querySelector('input[name="email"]') ||
                                          doc.querySelector('input[type="email"]');
                        
                        console.log('🔍 필드 검색:', {
                            name: nameInput?.value,
                            email: emailInput?.value
                        });
                        
                        if (emailInput && emailInput.value && emailInput.value.includes('@')) {
                            let userName = '사용자';
                            
                            if (nameInput && nameInput.value && nameInput.value.trim()) {
                                userName = nameInput.value.trim();
                            } else {
                                userName = emailInput.value.split('@')[0];
                            }
                            
                            const userData = {
                                email: emailInput.value.trim(),
                                name: userName,
                                uid: emailInput.value.split('@')[0]
                            };
                            
                            console.log('✅ fetch로 사용자 정보 획득:', userData);
                            return userData;
                        }
                    } catch (fetchError) {
                        console.warn('⚠️ fetch 실패:', fetchError.message);
                    }
                    
                    // 3. 모든 방법 실패 - 로그아웃 상태
                    console.error('❌ 로그아웃 상태 확인');
                    sessionStorage.removeItem('CEO_PLAN_USER');
                    return null;
                    
                } catch (error) {
                    console.error('❌ getUserInfo 전체 오류:', error);
                    return null;
                }
            }

            async function init() {
                console.log('🚀 앱 초기화 시작');
                currentUser = await getUserInfo();
                
                console.log('👤 현재 사용자:', currentUser);
                
                if (!currentUser || !currentUser.email) {
                    console.log('❌ 로그인 필요');
                    document.getElementById('loading').style.display = 'none';
                    document.getElementById('cards-container').innerHTML = `
                        <div style="background: linear-gradient(135deg, #1a1a1a, #2a2a2a); padding: 60px 40px; border-radius: 16px; text-align: center; border: 1px solid #333;">
                            <svg width="64" height="64" viewBox="0 0 24 24" fill="none" stroke="#8b5cf6" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="margin: 0 auto 24px;">
                                <rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect>
                                <path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
                            </svg>
                            <h2 style="font-size: 24px; color: #ffffff; margin-bottom: 16px;">로그인이 필요합니다</h2>
                            <p style="color: #888; font-size: 16px; line-height: 1.6; margin-bottom: 32px;">
                                CEO플랜 상담화법을 사용하려면<br>
                                오로지교육 회원 로그인이 필요합니다.
                            </p>
                            <button onclick="location.reload()" style="
                                background: linear-gradient(135deg, #8b5cf6, #7c3aed);
                                color: white;
                                border: none;
                                padding: 14px 32px;
                                border-radius: 8px;
                                font-size: 16px;
                                font-weight: 600;
                                cursor: pointer;
                            ">새로고침</button>
                        </div>
                    `;
                    return;
                }
                
                // 사용자 이름 표시
                const userNameDisplay = document.getElementById('user-name-display');
                if (userNameDisplay && currentUser.name) {
                    userNameDisplay.textContent = currentUser.name;
                    console.log('✅ 사용자명 UI 업데이트:', currentUser.name);
                } else {
                    console.error('❌ user-name-display 요소를 찾을 수 없거나 이름이 없음');
                }
                
                // 병렬 로딩으로 속도 개선 (스크립트 데이터 + 사용자 데이터 동시 로드)
                console.log('🚀 병렬 데이터 로딩 시작...');
                const loadStartTime = Date.now();
                
                await Promise.all([
                    loadScriptData(),
                    loadUserData()
                ]);
                
                const loadEndTime = Date.now();
                console.log('📚 스크립트 데이터:', scriptData.length, '개');
                console.log('👤 사용자 데이터 로드 완료');
                console.log('⚡ 총 로딩 시간:', (loadEndTime - loadStartTime) + 'ms');
                
                renderCategorySelect();
                console.log('📂 카테고리 선택 렌더링 완료');
                
                renderCards(true);
                console.log('🎴 카드 렌더링 완료');
                
                updateCounts();
                console.log('📊 카운트 업데이트 완료');
                
                setupEventListeners();
                console.log('🎧 이벤트 리스너 설정 완료');
                
                console.log('✅ 앱 초기화 완료');
            }

            async function loadScriptData() {
                try {
                    const cached = localStorage.getItem(CACHE_KEY);
                    const cacheTime = localStorage.getItem(CACHE_KEY + '_time');
                    
                    if (cached && cacheTime && (Date.now() - parseInt(cacheTime)) < CACHE_DURATION) {
                        scriptData = JSON.parse(cached);
                        console.log('✅ 캐시 데이터 사용:', scriptData.length, '개');
                        document.getElementById('loading').style.display = 'none';
                        return;
                    }
                    
                    console.log('🚀 GitHub에서 빠른 데이터 로드 중...');
                    const response = await fetch(GITHUB_DATA_URL);
                    const result = await response.json();
                    if (result.success) {
                        scriptData = result.data;
                        localStorage.setItem(CACHE_KEY, JSON.stringify(scriptData));
                        localStorage.setItem(CACHE_KEY + '_time', Date.now().toString());
                        console.log('✅ 데이터 로드 완료:', scriptData.length, '개');
                        document.getElementById('loading').style.display = 'none';
                    } else {
                        console.error('❌ 서버 응답 실패:', result);
                    }
                } catch (error) {
                    console.error('❌ 데이터 로드 실패:', error);
                    document.getElementById('loading').innerHTML = '<div style="color: #ef4444;">데이터 로드 실패</div>';
                }
            }

            async function loadUserData() {
                if (!currentUser || !currentUser.email) return;
                
                try {
                    const { data: favData } = await supabase
                        .from('user_favorites')
                        .select('script_id')
                        .eq('user_email', currentUser.email);
                    favorites = favData ? favData.map(f => f.script_id) : [];

                    const { data: memoData } = await supabase
                        .from('user_memos')
                        .select('*')
                        .eq('user_email', currentUser.email);
                    memos = {};
                    if (memoData) {
                        memoData.forEach(m => {
                            memos[m.script_id] = m.memo_text;
                        });
                    }

                    const { data: recentData } = await supabase
                        .from('user_recent')
                        .select('script_id')
                        .eq('user_email', currentUser.email)
                        .order('viewed_at', { ascending: false })
                        .limit(10);
                    recentViewed = recentData ? recentData.map(r => r.script_id) : [];
                    
                    console.log('✅ 사용자 데이터:', {
                        favorites: favorites.length,
                        memos: Object.keys(memos).length,
                        recent: recentViewed.length
                    });
                } catch (error) {
                    console.error('사용자 데이터 로드 실패:', error);
                }
            }

            function renderCategorySelect() {
                const categories = ['전체', ...new Set(scriptData.map(s => s.category))];
                const select = document.getElementById('category-select');
                select.innerHTML = categories.map(cat => 
                    `<option value="${cat}" ${cat === selectedCategory ? 'selected' : ''}>${cat}</option>`
                ).join('');
            }

            function renderCards(reset = true) {
                const filtered = getFilteredData();
                const container = document.getElementById('cards-container');
                const noResults = document.getElementById('no-results');

                if (reset) {
                    currentPage = 1;
                    container.innerHTML = '';
                }

                if (filtered.length === 0) {
                    container.style.display = 'none';
                    noResults.style.display = 'block';
                    document.getElementById('results-count').textContent = '0개 화법';
                    return;
                }

                container.style.display = 'block';
                noResults.style.display = 'none';
                document.getElementById('results-count').textContent = `${filtered.length}개 화법`;

                const startIndex = (currentPage - 1) * itemsPerPage;
                const endIndex = startIndex + itemsPerPage;
                const currentItems = filtered.slice(startIndex, endIndex);
                
                const newCards = currentItems.map(script => {
                    const isFavorite = favorites.includes(script.id);
                    const memo = memos[script.id];
                    
                    return `
                        <div class="card" data-id="${script.id}">
                            <div class="card-header" onclick="window.__ceoToggleCard(${script.id})">
                                <div class="card-header-left">
                                    <div class="card-badges">
                                        <span class="badge badge-scene">${script.scene}</span>
                                        <span class="badge badge-category">${script.category}</span>
                                    </div>
                                    <div class="card-question">${script.question}</div>
                                </div>
                                <div style="display: flex; align-items: center;">
                                    <button class="heart-btn" onclick="event.stopPropagation(); window.__ceoToggleFavorite(${script.id})">
                                        ${isFavorite ? 
                                            '<svg viewBox="0 0 24 24" fill="#8b5cf6" stroke="#8b5cf6" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M19 21l-7-5-7 5V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2z"></path></svg>' : 
                                            '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M19 21l-7-5-7 5V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2z"></path></svg>'
                                        }
                                    </button>
                                    <div class="expand-icon">
                                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                            <polyline points="6 9 12 15 18 9"></polyline>
                                        </svg>
                                    </div>
                                </div>
                            </div>
                            <div class="card-body">
                                <div class="card-answer">${script.answer}</div>
                                ${memo ? `<div class="memo-box">
                                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                        <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"></path>
                                    </svg>
                                    <span>${memo}</span>
                                </div>` : ''}
                                <div class="keywords">
                                    ${script.keywords.map(k => `<span class="keyword-tag">#${k}</span>`).join('')}
                                </div>
                                <div class="card-actions">
                                    <div class="ceo-btn-group">
                                        <button class="ceo-btn ceo-btn-primary ceo-btn-half" onclick="event.stopPropagation(); window.__ceoCopyToClipboard('${script.answer.replace(/"/g, '&quot;').replace(/'/g, "\\'")}', this)">
                                            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                                <rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect>
                                                <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path>
                                            </svg>
                                            복사
                                        </button>
                                        <button class="ceo-btn ceo-btn-primary ceo-btn-half ceo-btn-ai" onclick="event.stopPropagation(); window.__ceoOpenAIAnswer('${script.question.replace(/'/g, "\\'")}')">
                                            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                                <circle cx="12" cy="12" r="5"></circle>
                                                <path d="m12 1-3 6-6 3 6 3 3 6 3-6 6-3-6-3-3-6z"></path>
                                            </svg>
                                            AI 답변
                                        </button>
                                    </div>
                                    <button class="ceo-btn ceo-btn-secondary" onclick="event.stopPropagation(); window.__ceoOpenMemoModal(${script.id})">
                                        <svg width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                            <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"></path>
                                        </svg>
                                    </button>
                                    <button class="ceo-btn ceo-btn-tertiary" onclick="event.stopPropagation(); window.__ceoShareScript(${script.id})">
                                        <svg width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                            <line x1="22" y1="2" x2="11" y2="13"></line>
                                            <polygon points="22 2 15 22 11 13 2 9 22 2"></polygon>
                                        </svg>
                                    </button>
                                </div>
                            </div>
                        </div>
                    `;
                }).join('');

                if (reset) {
                    container.innerHTML = newCards;
                } else {
                    container.innerHTML += newCards;
                }
            }

            function loadMoreCards() {
                const filtered = getFilteredData();
                const maxPages = Math.ceil(filtered.length / itemsPerPage);
                
                if (currentPage >= maxPages || isLoading) {
                    return;
                }
                
                isLoading = true;
                currentPage++;
                
                setTimeout(() => {
                    renderCards(false);
                    isLoading = false;
                }, 100);
            }

            function toggleCard(id) {
                const card = document.querySelector(`.card[data-id="${id}"]`);
                card.classList.toggle('expanded');
                if (card.classList.contains('expanded')) {
                    addToRecent(id);
                }
            }

            function getFilteredData() {
                let filtered = [...scriptData];

                if (searchTerm && searchTerm.trim()) {
                    const term = searchTerm.trim().toLowerCase();
                    filtered = filtered.filter(s => {
                        try {
                            const questionMatch = s.question && String(s.question).toLowerCase().includes(term);
                            const answerMatch = s.answer && String(s.answer).toLowerCase().includes(term);
                            const keywordMatch = s.keywords && Array.isArray(s.keywords) && 
                                s.keywords.some(k => k && String(k).toLowerCase().includes(term));
                            return questionMatch || answerMatch || keywordMatch;
                        } catch (e) {
                            console.error('검색 필터 에러:', e, s);
                            return false;
                        }
                    });
                    
                    if (selectedCategory !== '전체') {
                        filtered = filtered.filter(s => s.category === selectedCategory);
                    }
                    
                    return filtered;
                }

                if (activeTab === 'all') {
                    if (selectedCategory !== '전체') {
                        filtered = filtered.filter(s => s.category === selectedCategory);
                    }
                } else if (activeTab === 'favorites') {
                    filtered = filtered.filter(s => favorites.includes(s.id));
                    if (selectedCategory !== '전체') {
                        filtered = filtered.filter(s => s.category === selectedCategory);
                    }
                } else if (activeTab === 'recent') {
                    filtered = filtered.filter(s => recentViewed.includes(s.id));
                    filtered.sort((a, b) => recentViewed.indexOf(a.id) - recentViewed.indexOf(b.id));
                    if (selectedCategory !== '전체') {
                        filtered = filtered.filter(s => s.category === selectedCategory);
                    }
                } else if (activeTab === 'memos') {
                    filtered = filtered.filter(s => memos[s.id]);
                    if (selectedCategory !== '전체') {
                        filtered = filtered.filter(s => s.category === selectedCategory);
                    }
                }

                return filtered;
            }

            function updateCounts() {
                const favCount = favorites.length;
                const memoCount = Object.keys(memos).length;
                
                document.getElementById('fav-count').textContent = favCount;
                document.getElementById('memo-count').textContent = memoCount;
            }

            function setupEventListeners() {
                document.querySelectorAll('.tab-btn').forEach(btn => {
                    btn.addEventListener('click', () => {
                        document.querySelectorAll('.tab-btn').forEach(b => b.classList.remove('active'));
                        btn.classList.add('active');
                        activeTab = btn.dataset.tab;
                        
                        selectedCategory = '전체';
                        const categorySelect = document.getElementById('category-select');
                        if (categorySelect) {
                            categorySelect.value = '전체';
                        }
                        
                        renderCards(true);
                    });
                });

                const searchInput = document.getElementById('search-input');
                const clearBtn = document.getElementById('clear-search');
                
                searchInput.addEventListener('input', (e) => {
                    searchTerm = e.target.value;
                    clearBtn.style.display = searchTerm ? 'block' : 'none';
                    renderCards(true);
                });

                clearBtn.addEventListener('click', () => {
                    searchTerm = '';
                    searchInput.value = '';
                    clearBtn.style.display = 'none';
                    renderCards(true);
                });

                document.getElementById('category-select').addEventListener('change', (e) => {
                    selectedCategory = e.target.value;
                    
                    activeTab = 'all';
                    document.querySelectorAll('.tab-btn').forEach(btn => {
                        btn.classList.remove('active');
                        if (btn.dataset.tab === 'all') {
                            btn.classList.add('active');
                        }
                    });
                    
                    renderCards(true);
                });

                document.getElementById('save-memo').addEventListener('click', saveMemo);
                document.getElementById('cancel-memo').addEventListener('click', closeMemoModal);
                document.getElementById('memo-modal').addEventListener('click', (e) => {
                    if (e.target.id === 'memo-modal') closeMemoModal();
                });

                window.addEventListener('scroll', () => {
                    if (isLoading) return;
                    
                    const scrollHeight = document.documentElement.scrollHeight;
                    const scrollTop = document.documentElement.scrollTop;
                    const clientHeight = document.documentElement.clientHeight;
                    
                    if (scrollHeight - scrollTop - clientHeight < 200) {
                        loadMoreCards();
                    }
                });
            }

            async function toggleFavorite(id) {
                if (!currentUser || !currentUser.email) {
                    alert('로그인이 필요합니다.');
                    return;
                }
                
                try {
                    if (favorites.includes(id)) {
                        await supabase
                            .from('user_favorites')
                            .delete()
                            .eq('user_email', currentUser.email)
                            .eq('script_id', id);
                        favorites = favorites.filter(f => f !== id);
                    } else {
                        await supabase
                            .from('user_favorites')
                            .insert({ user_email: currentUser.email, script_id: id });
                        favorites.push(id);
                    }
                    updateCounts();
                    renderCards(true);
                } catch (error) {
                    console.error('즐겨찾기 오류:', error);
                }
            }

            async function addToRecent(id) {
                if (!currentUser || !currentUser.email) return;
                
                try {
                    await supabase
                        .from('user_recent')
                        .insert({ user_email: currentUser.email, script_id: id });
                    
                    recentViewed = recentViewed.filter(r => r !== id);
                    recentViewed.unshift(id);
                    recentViewed = recentViewed.slice(0, 10);
                    updateCounts();
                } catch (error) {
                    console.error('최근 항목 오류:', error);
                }
            }

            function copyToClipboard(text, btn) {
                const decoded = text.replace(/&quot;/g, '"').replace(/&#39;/g, "'");
                navigator.clipboard.writeText(decoded).then(() => {
                    const originalText = btn.innerHTML;
                    btn.innerHTML = '<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"></polyline></svg> 복사완료';
                    setTimeout(() => {
                        btn.innerHTML = originalText;
                    }, 2000);
                });
            }

            function openAIAnswer(question) {
                const encodedQuestion = encodeURIComponent(question);
                const perplexityUrl = `https://www.perplexity.ai/search?q=${encodedQuestion}`;
                window.open(perplexityUrl, '_blank');
            }

            function shareScript(id) {
                const script = scriptData.find(s => s.id === id);
                if (!script) return;
                
                const text = `${script.question}\n\n${script.answer}`;
                
                if (navigator.share) {
                    navigator.share({ 
                        title: 'CEO플랜 상담화법',
                        text: text
                    }).catch(err => {
                        console.log('공유 취소 또는 실패:', err);
                    });
                } else {
                    copyToClipboard(text, { innerHTML: '' });
                    alert('클립보드에 복사되었습니다!');
                }
            }

            function openMemoModal(id) {
                if (!currentUser || !currentUser.email) {
                    alert('로그인이 필요합니다.');
                    return;
                }
                currentMemoId = id;
                document.getElementById('memo-textarea').value = memos[id] || '';
                document.getElementById('memo-modal').classList.add('active');
            }

            function closeMemoModal() {
                document.getElementById('memo-modal').classList.remove('active');
                currentMemoId = null;
            }

            async function saveMemo() {
                if (!currentUser || !currentUser.email) return;
                
                const memo = document.getElementById('memo-textarea').value.trim();
                
                try {
                    if (memo) {
                        await supabase
                            .from('user_memos')
                            .upsert({
                                user_email: currentUser.email,
                                script_id: currentMemoId,
                                memo_text: memo,
                                updated_at: new Date().toISOString()
                            }, {
                                onConflict: 'user_email,script_id'
                            });
                        memos[currentMemoId] = memo;
                    } else {
                        await supabase
                            .from('user_memos')
                            .delete()
                            .eq('user_email', currentUser.email)
                            .eq('script_id', currentMemoId);
                        delete memos[currentMemoId];
                    }
                    closeMemoModal();
                    updateCounts();
                    renderCards(true);
                } catch (error) {
                    console.error('메모 저장 오류:', error);
                }
            }

            // ✅ 전역 함수로 노출 (IIFE 외부에서 호출 가능하게)
            window.__ceoToggleCard = toggleCard;
            window.__ceoToggleFavorite = toggleFavorite;
            window.__ceoCopyToClipboard = copyToClipboard;
            window.__ceoOpenAIAnswer = openAIAnswer;
            window.__ceoShareScript = shareScript;
            window.__ceoOpenMemoModal = openMemoModal;

            // 앱 초기화
            init();
        })();
    </script>
</body>
</html>
