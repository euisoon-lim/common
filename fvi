        <div class="ai-sections">
          <div class="ai-card">
            <h4>요약</h4>
            <p style="margin:0;color:var(--muted);line-height:1.7">${esc(obj.intro || "프로필을 바탕으로 핵심 요약을 제공합니다.")}</p>
          </div>
          <div class="ai-card">
            <h4>강점 분석</h4>
            <ul>${toLI(obj.strengths)}</ul>
          </div>
          <div class="ai-card">
            <h4>보완점 분석</h4>
            <ul>${toLI(obj.weaknesses)}</ul>
          </div>
          <div class="ai-card ai-tips">
            <h4>가치 상승을 위한 3가지 팁</h4>
            <ol>${tips}</ol>
          </div>
        </div>
      `;
    };

    try{
      if(!GEMINI_API_KEY){ aiContent.textContent="API 키가 비어 있습니다. 키를 입력해 주세요."; return; }
      const res = await fetch(GEMINI_URL, { method:"POST", headers:{ "Content-Type":"application/json" },
        body: JSON.stringify({ contents:[{ parts:[{ text: prompt }]}] }) });
      if(!res.ok) throw new Error(`Gemini API 오류: ${res.status} ${res.statusText}`);
      const data=await res.json();
      let text=data?.candidates?.[0]?.content?.parts?.[0]?.text || "";
      text=text.trim().replace(/^```(?:json)?\s*/i,"").replace(/```$/i,"").trim();
      let obj;
      try{ obj=JSON.parse(text); }
      catch(_){
        obj={ intro:"프로필을 바탕으로 핵심 요약을 제공합니다.",
          strengths:["유지율 향상 가능성","채널 확장 여지","기초 체계 구축 시 빠른 성장 잠재력"],
          weaknesses:["활동량/기초 역량 부족","지속 가능한 채널/루틴 부재"],
          tips:[
            {title:"기초 역량 루틴", detail:"상품/화법/시스템 교육 4주 집중. 매일 상담 리허설 30분, 주 1회 롤플레잉 피드백."},
            {title:"채널 2개 정착", detail:"지인·소개, DB/세미나 중 2개를 선정해 8주 운영 지표(접촉-상담-계약) 관리."},
            {title:"유지율 설계", detail:"13회차 유지 목표 85%로 VOC/사후관리 체크리스트 도입 및 주간 점검."}
          ]};
      }
      aiContent.innerHTML = renderFromJSON(obj);
    }catch(e){
      console.error(e); aiContent.textContent="AI 분석에 실패했습니다. 잠시 후 다시 시도해 주세요.";
    }finally{
      aiBtn.disabled=false; aiBtn.style.opacity="1";
    }
  }
  aiBtn?.addEventListener("click", runGemini);

  /* ==== init ==== */
  function setTextInit(){ if(rangePNCText) rangePNCText.textContent=`${(+rangePNC.value||0)}%`; if(rangePRText) rangePRText.textContent=`${(+rangePR.value||0)}%`; }
  setTextInit(); showStep(currentStep);
})();
</script>
</body>
</html>
