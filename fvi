<!doctype html>
<html lang="ko">
<head>
<meta charset="utf-8"/>
<meta name="viewport" content="width=device-width,initial-scale=1"/>
<title>FP Value Index (FVI) 계산기</title>
<style>
  html, body { width:100%; height:100%; margin:0; padding:0; }
  :root{
    --primary-color:#0a7aff; --accent-warm:#c4552e;
    --background-color:#f2f2f7; --card:#ffffff; --text:#111;
    --muted:#4b5563; --border:#e5e7eb; --input:#f3f4f6; --shadow:0 22px 42px rgba(0,0,0,.12);
  }
  [data-theme="dark"]{
    --background-color:#0b0d0f; --card:#15181b; --text:#f5f7fa; --muted:#d1d5db;
    --border:#2c3136; --input:#1c2024; --shadow:0 22px 42px rgba(0,0,0,.38);
  }

/* === 자격증 리스트 2열 가득 채우기 (최종 수정본) === */
#cert-list {
  /* 1. 부모 컨테이너를 2열 그리드로 설정합니다. */
  display: grid !important;
  grid-template-columns: repeat(2, 1fr);
  gap: 12px;
}

#cert-list > .card-check {
  /* 2. 각 항목(label)을 flex 컨테이너로 만들어 자식(span)이 늘어날 수 있게 합니다. */
  /* 기존의 display: block !important 규칙을 덮어씁니다. */
  display: flex !important;
  margin: 0; /* 불필요한 여백 제거 */
}

#cert-list > .card-check > span {
  /* 3. 실제 보이는 버튼(span)이 너비를 100%로 꽉 채우도록 합니다. */
  width: 100%;
}

/* 모바일에서는 1열로 표시 */
@media (max-width: 680px) {
  #cert-list {
    grid-template-columns: 1fr;
  }
}


  #bg-fill{position:fixed; inset:0; z-index:-1;}
  .bg-gradient{background-size:400% 400%; animation:gradientBG 22s ease infinite;}
  .bg-gradient--light{background:linear-gradient(135deg,#ffe6e6,#fde2f3,#e5e9ff,#dff6ff,#e6ffe6,#fff6e0,#ffe6cc,#ffd9e6);}
  .bg-gradient--dark{background:linear-gradient(135deg,#2b3133,#272a35,#222a36,#1d2a31,#202f26,#2a2922,#2e2623,#2c252c);}
  @keyframes gradientBG{0%{background-position:0% 50%}50%{background-position:100% 50%}100%{background-position:0% 50%}}

  #gaw-calc-root{display:flex; justify-content:center; align-items:center; min-height:100svh; width:100%; padding:28px 12px;
    font-family:-apple-system,BlinkMacSystemFont,"SF Pro Text","SF Pro Display","Apple SD Gothic Neo","Noto Sans KR","Segoe UI",Roboto,Helvetica,Arial,sans-serif; letter-spacing:-.01em;}
  #gaw-calc-root *, #gaw-calc-root *::before, #gaw-calc-root *::after{ box-sizing:border-box; }

  #calculator-container{width:100%; max-width:760px; background:var(--card); color:var(--text); border-radius:24px; border:1px solid var(--border);
    box-shadow:var(--shadow); padding:46px 48px; position:relative;}

  /* theme switch */
  .theme-switch{position:absolute; top:16px; right:16px; z-index:10; display:inline-flex; flex-direction:column; align-items:flex-end; gap:6px;}
  .theme-switch input{display:none;}
  .theme-switch .track{width:96px; height:36px; border-radius:999px; background:var(--input); border:1px solid var(--border); position:relative;
    box-shadow: inset 0 1px 0 rgba(255,255,255,.25), 0 1px 2px rgba(0,0,0,.06);}
  .theme-switch .thumb{position:absolute; top:4px; left:4px; width:28px; height:28px; border-radius:50%; background:#fff; box-shadow:0 2px 6px rgba(0,0,0,.25);
    transition:left .25s ease, background .25s ease;}
  [data-theme="dark"] .theme-switch .thumb{background:#2b2f33;}
  .theme-switch input:checked + .track .thumb{left:64px}
  .theme-switch .switch-caption{font-size:12px; font-weight:700; color:var(--muted); display:flex; gap:10px; margin-right:4px; align-items:center;}
  .switch-caption .separator{opacity:.35;} .switch-caption .light,.switch-caption .dark{opacity:.45;}
  .theme-switch input:not(:checked) ~ .switch-caption .light{opacity:1; color:var(--text);}
  .theme-switch input:checked ~ .switch-caption .dark{opacity:1; color:var(--text);}

  /* headings */
  #calculator-container h1{ text-align:center; font-size:32px; line-height:1.2; font-weight:800; margin:0 0 8px; letter-spacing:-.02em; }
  #subtitle{ text-align:center; color:var(--muted); margin-bottom:18px; }
  #progress-bar-container{ height:12px; border-radius:999px; overflow:hidden; background:#2f343a; margin:8px 0 28px; }
  #progress-bar{ height:100%; width:0%; background:var(--primary-color); transition:width .35s ease; }

  .gstep{ display:none; animation:fade .22s; } .gstep.active{ display:block; }
  .gstep h2{ font-size:22px; line-height:1.35; font-weight:800; margin:6px 0 18px; }

  .input-group{ margin-bottom:16px; }
  .input-row{ display:grid; grid-template-columns:1fr 1fr; gap:12px; }
  @media (max-width:680px){ .input-row{ grid-template-columns:1fr; } }

  label{ display:block; color:var(--muted); font-weight:800; margin-bottom:8px; }
  input[type="number"], input[type="text"]{ width:100%; height:56px; border-radius:14px; border:1px solid var(--border); background:var(--input);
    color:var(--text); -webkit-text-fill-color:var(--text); font-size:18px; font-weight:800; padding:0 16px; outline:none; }
  input::placeholder{ color:#9aa3ad; } [data-theme="dark"] input::placeholder{ color:#e5e7eb; }

  /* sliders */
  .slider{ width:100%; } input[type="range"]{ width:100%; height:12px; border-radius:999px; -webkit-appearance:none; appearance:none; outline:none; background:#2f343a; }
  input[type="range"]::-webkit-slider-thumb{ -webkit-appearance:none; width:26px; height:26px; border-radius:50%; background:var(--accent-warm); border:3px solid #ffffff22; margin-top:-7px; }
  input[type="range"]::-moz-range-thumb{ width:26px; height:26px; border-radius:50%; background:var(--accent-warm); border:3px solid #ffffff22; }
  .val-pill{ display:inline-block; min-width:56px; padding:4px 10px; border-radius:999px; font-weight:900; background:#e7f0ff; color:#0a58ca; font-size:12px; margin-left:6px; }

  /* checkbox cards (compact for certs) */
  .checks{ display:flex; flex-direction:column; gap:12px; }
  .card-check input{ display:none; }
  .card-check span{ display:flex; align-items:center; gap:12px; min-height:56px; border-radius:12px; background:#eef2f7; border:1px solid var(--border);
    color:#1f2937; padding:10px 16px; font-size:15px; font-weight:800; }
  [data-theme="dark"] .card-check span{ color:#f2f6fb; background:#21262c; }
  .card-check input:checked + span{ border-color:var(--primary-color); box-shadow:0 0 0 2px rgba(10,122,255,.25); }
  .card-check span i{ width:22px; height:22px; border-radius:6px; border:2px solid #8a9096; background:#15181a; position:relative; }
  .card-check input:checked + span i{ border-color:var(--primary-color); background:var(--primary-color); }
  .card-check input:checked + span i::after{ content:""; position:absolute; left:6px; top:2px; width:8px; height:14px; border:3px solid #fff; border-top:none; border-left:none; transform:rotate(45deg); }
  /* compact */
  .checks.compact .card-check span{ min-height:48px; padding:8px 14px; font-size:14px; }

  /* segmented 5 */
  .seg5{ display:grid; grid-template-columns:repeat(5,1fr); gap:8px; }
  .seg5 input{ display:none; }
  .seg5 label{ user-select:none; height:44px; border-radius:12px; display:flex; align-items:center; justify-content:center; font-weight:900;
    border:1px solid var(--border); background:var(--card); }
  .seg5 input:checked + label{ border-color:var(--primary-color); box-shadow:0 0 0 2px rgba(10,122,255,.20); }

  /* nav buttons */
  #navigation-buttons{ margin-top:24px; display:flex; gap:10px; }
  button{ height:56px; border-radius:12px; border:none; background:var(--primary-color); color:#fff; font-size:18px; font-weight:900; letter-spacing:-.01em;
    cursor:pointer; transition:transform .08s, filter .2s; flex:1; } button:active{ transform:translateY(1px); }
  #prev-btn{ background:transparent; color:var(--primary-color); border:1px solid var(--primary-color); }

  /* result */
  #result-display{ text-align:center; }
  #badge{ display:inline-block; padding:6px 10px; border-radius:999px; font-size:12px; font-weight:900; margin-bottom:6px; background:#e5f0ff; color:#0a58ca; }
  #fvi-score{ font-size:40px; font-weight:900; margin:0 0 8px; }
  .final-value{ font-size:28px; font-weight:900; color:var(--text); margin:10px 0 4px; }
  .value-unit{ font-size:16px; color:#7fb1ff; }
  .result-description{ color:var(--muted); margin:6px 0 16px; }
  .insights{ text-align:left; background:var(--input); border:1px solid var(--border); border-radius:12px; padding:14px; margin-top:14px; color:var(--muted); white-space:pre-line; }

  /* AI */
  .loader{ width:24px; height:24px; border:3px solid var(--border); border-bottom-color: var(--primary-color); border-radius:50%; animation: rotation 1s linear infinite; }
  @keyframes rotation{ 0%{transform:rotate(0)} 100%{transform:rotate(360deg)} }
  #ai-result-container{ margin-top:20px }
  .ai-sections{ display:grid; gap:21px; padding:20px 6px; }
  .ai-card{ padding:6px 16px; text-align:left; }
  .ai-card h4{ margin:0 0 10px; font-size:20px; font-weight:900; color:var(--text); }

  @keyframes fade{ from{opacity:0; transform:translateY(6px);} to{opacity:1; transform:translateY(0);} }
</style>
</head>
<body>
<div id="bg-fill" class="bg-gradient bg-gradient--light"></div>

<div id="gaw-calc-root" data-theme="light">
  <div id="calculator-container">

    <div class="theme-switch" id="theme-switch">
      <input type="checkbox" id="theme-checkbox" aria-label="Theme switch" />
      <span class="track"><span class="thumb"></span></span>
      <div class="switch-caption" aria-hidden="true">
        <span class="light">Light</span><span class="separator">•</span><span class="dark">Dark</span>
      </div>
    </div>

    <h1>FP Value Index (FVI)</h1>
    <p id="subtitle">현재 가치와 성장 잠재력을 함께 보는 설계사 평가 지수</p>
    <div id="progress-bar-container"><div id="progress-bar"></div></div>

    <form id="calculator-form" onsubmit="return false;">
      <!-- 1 기본 -->
      <div class="gstep active" id="gstep-1">
        <h2>기본 정보를 입력해 주세요</h2>
        <div class="input-row">
          <div class="input-group"><label for="birth-year">출생 연도 (YYYY)</label>
            <input type="number" id="birth-year" placeholder="예: 1987" min="1940" max="2015" inputmode="numeric"/></div>
          <div class="input-group"><label for="career-length">총 경력 (년)</label>
            <input type="number" id="career-length" placeholder="예: 7" min="0" inputmode="numeric"/></div>
        </div>
      </div>

      <!-- 2 소득 -->
      <div class="gstep" id="gstep-2">
        <h2>직전년도 소득을 입력해 주세요</h2>
        <div class="input-group">
          <label for="prev-income-krw">연 소득 (원)</label>
          <input type="text" id="prev-income-krw" placeholder="예: 100,000,000" inputmode="numeric" />
          <div class="hint" id="prev-income-hint">예: 100,000,000원 = 1억 0만원</div>
        </div>
      </div>

      <!-- 3 월 성과 -->
      <div class="gstep" id="gstep-3">
        <h2>월간 성과를 알려주세요</h2>
        <div class="input-row">
          <div class="input-group">
            <label for="monthly-contracts">월 평균 계약 건수 (건)</label>
            <input type="number" id="monthly-contracts" placeholder="예: 15" min="0" inputmode="numeric" />
          </div>
          <div class="input-group">
            <label for="monthly-premium">월 평균 업적 (만원)</label>
            <input type="number" id="monthly-premium" placeholder="예: 200" min="0" inputmode="numeric" />
          </div>
        </div>
      </div>

      <!-- 4 포트폴리오/품질 -->
      <div class="gstep" id="gstep-4">
        <h2>포트폴리오와 품질 지표</h2>
        <div class="input-row">
          <div class="input-group">
            <label for="non-life-ratio">손해보험 비중: <span id="non-life-ratio-value" class="val-pill">50%</span></label>
            <input class="slider" type="range" id="non-life-ratio" min="0" max="100" value="50" />
          </div>
          <div class="input-group">
            <label for="persistency-range">유지율(13회차): <span id="persistency-value" class="val-pill">85%</span></label>
            <input class="slider" type="range" id="persistency-range" min="0" max="100" value="85" />
          </div>
        </div>
      </div>

      <!-- 5 채널 -->
      <div class="gstep" id="gstep-5">
        <h2>영업 방식(해당 모두 선택)</h2>
        <div class="checks">
          <label class="card-check"><input type="checkbox" name="sales-method" value="pioneering"><span><i></i>개척 영업</span></label>
          <label class="card-check"><input type="checkbox" name="sales-method" value="referral"><span><i></i>소개 영업</span></label>
          <label class="card-check"><input type="checkbox" name="sales-method" value="db"><span><i></i>DB 영업(인/아웃바운드)</span></label>
          <label class="card-check"><input type="checkbox" name="sales-method" value="seminar"><span><i></i>세미나 영업</span></label>
          <label class="card-check"><input type="checkbox" name="sales-method" value="inhouse"><span><i></i>인하우스/유입</span></label>
          <label class="card-check"><input type="checkbox" name="sales-method" value="niche"><span><i></i>특화 시장</span></label>
        </div>
      </div>

      <!-- 6 자격/성장 : 컴팩트 -->
      <div class="gstep" id="gstep-6">
        <h2>전문성과 성장성</h2>
        <div class="input-group">
          <label>자격증/교육 이수 (해당 모두 체크)</label>
<div class="compact" id="cert-list">
<label class="card-check"><input type="checkbox" value="life"><span><i></i>생명보험설계사</span></label>
  <label class="card-check"><input type="checkbox" value="nonlife"><span><i></i>손해보험설계사</span></label>
  <label class="card-check"><input type="checkbox" value="third"><span><i></i>제3보험설계사</span></label>
  <label class="card-check"><input type="checkbox" value="variable"><span><i></i>변액보험판매관리사</span></label>
  <label class="card-check"><input type="checkbox" value="afpk"><span><i></i>AFPK®</span></label>
  <label class="card-check"><input type="checkbox" value="cfp"><span><i></i>CFP®</span></label>
  <label class="card-check"><input type="checkbox" value="lossadj"><span><i></i>손해사정사</span></label>
  <label class="card-check"><input type="checkbox" value="fund"><span><i></i>펀드투자권유대행인</span></label>
  <label class="card-check"><input type="checkbox" value="securities"><span><i></i>증권투자권유대행인</span></label>
</div>
          <div class="hint">전문점수 총합 최대 +10, 금액 가산 최대 +1,000만원</div>
        </div>
      </div>

      <!-- 7+ 추가 문항: 2문항씩 페이지 생성 (제목 없음) -->
      <!-- 동적으로 삽입됨 -->

      <!-- 결과 -->
      <div class="gstep" id="gstep-result">
        <div id="result-display">
          <div id="badge">Result</div>
          <h2>당신의 FVI와 예상 금액</h2>
          <div id="fvi-score">FVI 0</div>
          <div class="result-description" id="grade-text">등급 산정 중…</div>
          <p class="final-value"><span id="final-value-text">0원</span> <span class="value-unit">/ 예상 금액</span></p>
          <div class="insights" id="insights-box"></div>

          <div style="margin-top:14px; display:flex; gap:10px;">
            <button type="button" id="restart-btn">다시 계산</button>
            <button type="button" id="ai-consulting-btn">AI 컨설팅 받기</button>
          </div>

          <div id="ai-result-container" style="display:none;">
            <h3 style="margin:14px 0 10px;font-size:16px;">GA WORLD AI의 분석 및 조언</h3>
            <div id="ai-result-content"
                 style="border:1px solid var(--border);background:var(--input);padding:14px;border-radius:12px;color:var(--muted);min-height:44px;"></div>
          </div>
        </div>
      </div>
    </form>

    <div id="navigation-buttons">
      <button type="button" id="prev-btn" style="display:none;">이전</button>
      <button type="button" id="next-btn">다음</button>
      <button type="button" id="submit-btn" style="display:none;">결과 확인</button>
    </div>
  </div>
</div>

<script>
(function(){
  const root=document.getElementById("gaw-calc-root"); if(!root) return;

  /* ==== Theme ==== */
  const bgFill=document.getElementById("bg-fill"); const themeCheckbox=document.getElementById("theme-checkbox");
  function applyBg(theme){ bgFill.classList.add("bg-gradient"); bgFill.classList.remove("bg-gradient--light","bg-gradient--dark");
    bgFill.classList.add(theme==="dark"?"bg-gradient--dark":"bg-gradient--light"); }
  function applyTheme(theme){ root.setAttribute("data-theme",theme); localStorage.setItem("fvi-theme",theme);
    themeCheckbox.checked=(theme==="dark"); applyBg(theme); }
  const prefersDark=window.matchMedia&&window.matchMedia("(prefers-color-scheme: dark)").matches;
  applyTheme(localStorage.getItem("fvi-theme")||(prefersDark?"dark":"light"));
  document.querySelector(".theme-switch .track")?.addEventListener("click",()=>{ themeCheckbox.checked=!themeCheckbox.checked; themeCheckbox.dispatchEvent(new Event("change")); });
  themeCheckbox?.addEventListener("change",()=>applyTheme(themeCheckbox.checked?"dark":"light"));

  /* ==== DOM ==== */
  const progressBar=root.querySelector("#progress-bar");
  const prevBtn=root.querySelector("#prev-btn");
  const nextBtn=root.querySelector("#next-btn");
  const submitBtn=root.querySelector("#submit-btn");
  const prevIncomeKRWInput=root.querySelector("#prev-income-krw");
  const prevIncomeHint=root.querySelector("#prev-income-hint");
  const rangePNC=root.querySelector("#non-life-ratio"), rangePR=root.querySelector("#persistency-range");
  const rangePNCText=root.querySelector("#non-life-ratio-value"), rangePRText=root.querySelector("#persistency-value");
  const fviScoreEl=root.querySelector("#fvi-score"), finalValueText=root.querySelector("#final-value-text"), gradeText=root.querySelector("#grade-text"), insightsBox=root.querySelector("#insights-box");

  /* ==== 추가 질문 사양 (2문항씩 페이징) ==== */
  const EXTRA_QUESTIONS = [
    { id:"q-daily-consults", label:"하루 평균 상담 건수는 몇 건입니까?", type:"number", placeholder:"예: 4",
      bonusCalc:(v)=>{const n=+v||0; if(n>=5) return "q5"; if(n===4) return "q4"; if(n===3) return "q3"; return "q2"; }},
    { id:"q-managed-clients", label:"현재 유지 관리 중인 고객 수는 몇 명입니까?", type:"number", placeholder:"예: 220",
      bonusCalc:(v)=>{const n=+v||0; if(n>=300) return "m300"; if(n>=200) return "m200"; if(n>=100) return "m100"; return "m0"; }},
    { id:"q-referral-rate", label:"기존 고객 소개로 유입되는 비율(%)", type:"range", min:0, max:100, step:1,
      bonusCalc:(v)=>{const n=+v||0; if(n>=40) return "r40"; if(n>=20) return "r20"; if(n>=10) return "r10"; return "r0"; }},
    { id:"q-household-share", label:"가구(세대) 전체를 관리하는 고객 비중(%)", type:"range", min:0, max:100, step:1,
      bonusCalc:(v)=>{const n=+v||0; if(n>=30) return "h30"; if(n>=20) return "h20"; if(n>=10) return "h10"; return "h0"; }},
    { id:"q-digital", label:"온라인/디지털 채널 운영 수준", type:"scale5", scaleLabels:["없음","기초","보통","적극","체계적"], map:["dig-l1","dig-l2","dig-l3","dig-l4","dig-l5"] },
    { id:"q-esign", label:"비대면 상담/전자서명 프로세스 숙련도", type:"scale5", scaleLabels:["미숙","보통-","보통","능숙","매우 능숙"], map:["es-l1","es-l2","es-l3","es-l4","es-l5"] },
    { id:"q-recruit-num", label:"리쿠르팅 경험(최근 성공/정착 인원 수)", type:"number", placeholder:"예: 3",
      bonusCalc:(v)=>{const n=+v||0; return (n>=3)?"rec-3plus":"none"; }},
    { id:"q-position", label:"소속 조직 내 직급", type:"scale5", scaleLabels:["FP","부지점장","지점장","지사장","본부장 이상"], map:["pos-fp","pos-sub","pos-branch","pos-area","pos-hq"] },
